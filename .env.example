# Copy to .env.local and fill in. .env.local is gitignored — keep it that way.
#
# Published iCloud calendar URLs. In Calendar on macOS: right-click a calendar
# -> Share Calendar -> tick "Public Calendar" -> copy the link.
#
# These links grant read access to that calendar to anyone who has them, so
# treat them like passwords: never commit them, never paste them anywhere public.
#
# Any CALENDAR_<NAME>_URL var is picked up on first run and seeded into the
# database; after that, manage calendars in the app's Calendars dialog.

CALENDAR_WORK_URL=
CALENDAR_UNI_URL=
CALENDAR_SOCIETY_URL=
CALENDAR_HEALTH_URL=
CALENDAR_DILLY_DALLY_URL=
CALENDAR_LIFE_URL=

# Display timezone and the timezone weekly goals reset in.
APP_TZ=Australia/Sydney

# Port the local server listens on.
PORT=4321
